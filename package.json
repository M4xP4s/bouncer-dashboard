{
  "name": "bouncer-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run start:dev -w apps/api & npm run dev -w apps/web & wait",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:e2e -w apps/api",
    "check:contracts": "tsc -p packages/contracts && node apps/web/src/fixtures/check.ts",
    "check:two-process": "node scripts/two-process-check.mjs",
    "demo:traffic": "node scripts/traffic.mjs",
    "seed:users": "npm run build -w apps/api && node --env-file=.env.example --env-file-if-exists=.env apps/api/dist/users/seed.js",
    "check:population": "npm run build -w apps/api && node scripts/population-check.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
