# Copy to .env for host-mode development (npm run dev). Docker Compose reads
# this file directly. The API refuses to start if one of these is missing or
# malformed; only DEMO_USERS may be empty.

# HTTP and socket port.
PORT=3000

# Address of Redis. Compose overrides this for the app container.
REDIS_URL=redis://localhost:6379

# Demo authentication, not a secret: the one admin credential.
ADMIN_TOKEN=demo-admin-token

# Demo authentication: comma-separated userId:token pairs, registered in Redis
# at start-up. A registered user keeps its token.
DEMO_USERS=user-01:demo-token-01,user-02:demo-token-02,user-03:demo-token-03,user-04:demo-token-04,user-05:demo-token-05,user-06:demo-token-06,user-07:demo-token-07,user-08:demo-token-08,user-09:demo-token-09,user-10:demo-token-10,user-11:demo-token-11,user-12:demo-token-12
